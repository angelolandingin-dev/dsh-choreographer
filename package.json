  "homepage": "https://github.com/angelolandingin-dev/dsh-choreographer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelolandingin-dev/dsh-choreographer.git"
  },
  "bugs": {
    "url": "https://github.com/angelolandingin-dev/dsh-choreographer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "agent-presets",
    "agent-teams",
    "teammates",
    "orchestrator",
    "team-lead"
  ],
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node tools/validate.cjs"
  },
  "devDependencies": {
